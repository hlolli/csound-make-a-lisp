;; A sawtooth voice with a falling filter cutoff and a stereo reverb send.
(csound/definst SoftSaw [note 60 gain 0.02 pan 0.5]
  (let* [frequency (csound/cpsmidinn note)
         cutoff ((csound/at-rate :k csound/expseg) 5000 0.3 1200 (- p3 0.3) 400)
         envelope (csound/linseg 0 0.02 1 0.08 0.6 (- p3 0.6) 0.6 0.2 0)
         oscillator (csound/vco2 gain frequency)
         filtered (csound/butterlp (* oscillator envelope) cutoff)
         dry (csound/outputs (csound/pan2 filtered pan))
         wet (csound/outputs
               (csound/reverbsc (nth dry 0) (nth dry 1) 0.65 7000))]
    (csound/outs (+ (nth dry 0) (* 0.25 (nth wet 0)))
                 (+ (nth dry 1) (* 0.25 (nth wet 1))))))

;; Entries are [start time, MIDI note, stereo position].
(map (fn* (note)
       (csound/event "i" SoftSaw (nth note 0) 1.6 (nth note 1) 0.02 (nth note 2)))
  [[0 60 0.2] [0.2 64 0.5] [0.4 67 0.8]
   [1.6 57 0.2] [1.8 62 0.5] [2.0 65 0.8]])

(csound/event "e" 3.8 0)
