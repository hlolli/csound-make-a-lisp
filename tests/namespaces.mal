(def checks (atom 0))
(defn check [label expected actual]
  (if (= expected actual)
    (swap! checks inc)
    (throw (str label ": expected " (pr-str expected) ", got " (pr-str actual)))))
(defn fails? [f] (try* (do (f) false) (catch* e true)))
(check "initial namespace" 'user *ns*)
(check "namespace identity" 'user (ns-name *ns*))
(check "missing namespace" nil (find-ns 'not-created))
(check "core qualified lookup" 4 (clojure.core/inc 3))
(check "division keeps its slash" 3 (clojure.core// 6 2))
(check "core refs are not user definitions" false (contains? (ns-publics 'user) 'inc))
(check "user definitions have full names" true (fn? user/check))
(def value :user)

(ns alpha)
(user/check "ns changes current namespace" 'alpha *ns*)
(user/check "ns brings in core helpers" 3 (inc 2))
(user/check "user definitions do not leak" true (user/fails? (fn [] value)))
(def value :alpha)
(defn read-value [] value)
(defn current-ns [] *ns*)
(defn make-reader [n] (fn [] [n value]))
(defn recurse [n] (if (= n 0) value (recurse (dec n))))
(defn define-local [] (def created-here value))
(def state (atom []))
(defmacro twice [form] (list 'do form form))
(defmacro call-reader [] '(alpha/read-value))
(alias 'c 'clojure.core)
(defn aliased-inc [n] (c/inc n))

(ns beta (:require [alpha :as a :refer [read-value twice call-reader]]))
(def value :beta)
(user/check "definitions stay separate" [:user :alpha :beta] [user/value alpha/value value])
(user/check "alias resolves a function" :alpha (a/read-value))
(user/check "referred function keeps its namespace" :alpha (read-value))
(user/check "function reads dynamic current namespace" 'beta (a/current-ns))
(user/check "closure keeps namespace and locals" [7 :alpha] ((a/make-reader 7)))
(user/check "recursion keeps namespace" :alpha (a/recurse 40))
(user/check "function keeps namespace aliases" 8 (a/aliased-inc 7))
(user/check "alias is private to its namespace" true (user/fails? (fn [] (c/inc 1))))
(user/check "local names shadow namespace definitions" :local (let [value :local] value))
(user/check "qualified names bypass unqualified locals" :alpha (let [value :local] a/value))
(user/check "definitions inside functions use their own namespace" :alpha (a/define-local))
(user/check "definition belongs to alpha" :alpha alpha/created-here)
(user/check "definition does not leak into beta" true (user/fails? (fn [] created-here)))
(user/check "imported macro runs in caller scope" [:beta :beta]
            (do (twice (swap! a/state conj value)) @a/state))
(user/check "macro can emit a qualified call" :alpha (call-reader))
(user/check "aliases are visible as a map" (hash-map 'a 'alpha) (ns-aliases 'beta))
(user/check "publics report owned values" :beta (get (ns-publics 'beta) 'value))
(user/check "publics omit referred functions" false (contains? (ns-publics 'beta) 'read-value))
(user/check "require can run through apply" nil (apply require '(alpha)))

(ns alpha)
(def value :updated)
(defn read-value [] :replacement)
(ns beta)
(user/check "alias reads current value" :updated a/value)
(user/check "refer follows redefinition" :replacement (read-value))
(user/check "ns preserves existing aliases" :replacement (a/read-value))
(user/check "saved atom identity crosses namespaces" [:beta :beta] @alpha/state)
(user/check "legacy def at top level belongs to current namespace" :legacy (def! legacy :legacy))
(user/check "legacy qualified lookup" :legacy beta/legacy)
(user/check "legacy def remains local inside let" [:local :legacy]
            [(let* [legacy :inner] (def! legacy :local)) legacy])
(user/check "core can be shadowed within a namespace" 9
            (do (def inc (fn [x] (+ x 2))) (inc 7)))
(user/check "qualified core stays intact" 8 (clojure.core/inc 7))
(user/check "another namespace keeps core helpers" 8 (alpha/aliased-inc 7))
(user/check "invalid definition does not run initializer" true
            (let [calls (atom 0)]
              (try* (def missing-ns/value (swap! calls inc)) (catch* error nil))
              (= 0 @calls)))

(in-ns 'bare)
(user/check "in-ns switches namespace" 'bare *ns*)
(user/check "in-ns starts without core refs" true (user/fails? (fn [] (inc 1))))
(clojure.core/refer 'clojure.core :only '[inc])
(user/check "explicit refer adds selected core function" 3 (inc 2))
(user/check "unselected core name remains unavailable" true (user/fails? (fn [] (dec 2))))
(ns bare)
(user/check "ns adds core refs to an existing namespace" 1 (dec 2))
(user/check "create-ns returns its name" 'empty-ns (create-ns 'empty-ns))
(user/check "create-ns does not switch" 'bare *ns*)
(user/check "find-ns finds a namespace" 'alpha (find-ns 'alpha))
(user/check "all-ns lists this session" true (some (fn [n] (= 'alpha n)) (all-ns)))
(user/check "name on symbol" "value" (name 'alpha/value))
(user/check "namespace on symbol" "alpha" (namespace 'alpha/value))
(user/check "name on keyword" "value" (name :alpha/value))
(user/check "namespace on keyword" "alpha" (namespace :alpha/value))
(user/check "simple name has no namespace" nil (namespace 'value))
(user/check "division is unqualified" nil (namespace '/))
(user/check "name preserves a string" "alpha/value" (name "alpha/value"))

(ns gamma (:require [alpha :refer :all]))
(user/check "refer all makes functions available" :replacement (read-value))
(ns user)
(check "refer leaves caller's definition in place" :user value)
(check "invalid namespace operations throw" true
       (every? identity
         (map (fn [form] (fails? (fn [] (eval form))))
              '[(ns) (ns "bad") (ns bad/name)
                (ns bad (:unsupported x)) (ns bad (:require [alpha :as "bad"]))
                (alias 'a 'missing-ns) (alias 'a/b 'alpha)
                (require '[alpha :refer [missing]]) (require '[alpha :as a :as b])
                (require '[alpha :refer 3]) (require '[alpha :unknown x])
                (require 3) (require '[]) (refer 'missing-ns)
                (refer 'alpha :only '[missing]) (find-ns "alpha")
                (in-ns :bad) (create-ns 'bad/name) (ns-publics 'missing-ns)
                (ns-aliases 'missing-ns) (all-ns 1) (name 3) (namespace "x")
                (def *ns* 'bad) (def missing-ns/value 2)])))
(check "failed ns leaves caller namespace" 'user *ns*)
(check "namespace maps are immutable" {} (do (assoc (ns-aliases 'user) 'x 'alpha) (ns-aliases 'user)))
(ns instruments.one)
(csound/definst tone [] (csound/outs (csound/oscili 0 440) (csound/oscili 0 440)))
(ns instruments.two)
(csound/definst tone [] (csound/outs (csound/oscili 0 220) (csound/oscili 0 220)))
(user/check "instrument host names stay distinct" false
            (= (pr-str instruments.one/tone) (pr-str tone)))
(ns user)
(println (str "PASS: " @checks " namespace checks"))
