(def! checks (atom 0))
(def! check
  (fn* (label expected actual)
    (if (= expected actual)
      (swap! checks inc)
      (throw (str label ": expected " (pr-str expected) ", got " (pr-str actual))))))
(def! fails?
  (fn* (thunk) (try* (do (thunk) false) (catch* e true))))

(check "identity" [1 nil false] (identity [1 nil false]))
(check "inc" 2.5 (inc 1.5))
(check "dec" -2.5 (dec -1.5))
(check "zero predicate" '(true false false) (map zero? [0 1 -1]))
(check "positive predicate" '(false true false) (map pos? [0 1 -1]))
(check "negative predicate" '(false false true) (map neg? [0 1 -1]))
(check "some predicate keeps false" '(false true true true) (map some? [nil false 0 []]))
(check "boolean" '(false false true true) (map boolean [nil false 0 []]))
(check "not equal unary" false (not= 1))
(check "not equal all same" false (not= [1] '(1) [1]))
(check "not equal one different" true (not= 1 1 2 1))
(check "constant nil" nil ((constantly nil) 1 2 3))
(check "constant false" false ((constantly false)))
(check "complement" '(true false true) (map (complement pos?) [-1 1 0]))
(check "complement variadic" true ((complement =) 1 2))
(check "partial without bound args" 6 ((partial +) 2 4))
(check "partial argument order" '(1 2 3 4) ((partial list 1 2) 3 4))
(check "composition identity" 7 ((comp) 7))
(check "composition one" 8 ((comp inc) 7))
(check "composition order" 11 ((comp inc (partial * 2) +) 2 3))
(check "composition zero input" 4 ((comp inc (constantly 3))))
(check "juxt" [4 2 3] ((juxt inc dec identity) 3))
(check "juxt argument forwarding" ['(1 2) [1 2]] ((juxt list vector) 1 2))
(check "closures retain composition inputs" 7
       (let* [f (let* [n 3] (comp (partial + n) inc))] (f 3)))

(check "next vector" '(2 3) (next [1 2 3]))
(check "next singleton" nil (next [1]))
(check "next nil" nil (next nil))
(check "second" 2 (second [1 2 3]))
(check "second missing" nil (second [1]))
(check "last" 3 (last '(1 2 3)))
(check "last empty" nil (last []))
(check "last nil" nil (last nil))
(check "butlast" '(1 2) (butlast [1 2 3]))
(check "butlast singleton" nil (butlast [1]))
(check "reverse" '(3 2 1) (reverse [1 2 3]))
(check "reverse nil" '() (reverse nil))
(check "not empty keeps collection type" true (vector? (not-empty [1])))
(check "not empty nil" nil (not-empty nil))
(check "not empty string" "abc" (not-empty "abc"))
(check "empty string" nil (not-empty ""))
(check "sequence of map entries" '([:a 1]) (seq {:a 1}))
(check "sequence of empty map" nil (seq {}))
(check "second string" "b" (second "abc"))
(check "last string" "c" (last "abc"))
(check "take string" '("a" "b") (take 2 "abc"))
(check "reverse string" '("c" "b" "a") (reverse "abc"))

(check "fold with seed" 16 (reduce + 10 [1 2 3]))
(check "fold without seed" 6 (reduce + [1 2 3]))
(check "empty seeded fold" false (reduce list false []))
(check "empty fold calls zero arity" 9 (reduce (fn* () 9) []))
(check "singleton fold avoids callback" 7 (reduce (fn* () (throw "called")) [7]))
(check "fold nil" 4 (reduce + 4 nil))
(check "fold string" "abc" (reduce str "" "abc"))
(check "fold map entries" 3 (reduce (fn* (n entry) (+ n (second entry))) 0 {:a 1 :b 2}))
(check "reduced deref" false @(reduced false))
(check "reduced nil" nil @(reduced nil))
(check "reduced predicate" '(false false true) (map reduced? [nil [1] (reduced 1)]))
(check "unreduced leaves plain values" 3 (unreduced 3))
(check "unreduced unwraps once" true (reduced? (unreduced (reduced (reduced 3)))))
(check "ensure reduced avoids nesting" 3 @(ensure-reduced (reduced 3)))
(check "ensure reduced wraps" 3 @(ensure-reduced 3))
(check "reduced equals itself" true (let* [r (reduced 3)] (= r r)))
(check "reduced values have distinct identities" false (= (reduced 3) (reduced 3)))
(check "ensure reduced preserves identity" true
       (let* [r (reduced 3)] (= r (ensure-reduced r))))
(check "nested reduced values have distinct identities" true
       (let* [r (reduced 3)] (not= r (reduced r))))
(check "empty seeded fold preserves reduced value" true
       (let* [r (reduced 3)] (= r (reduce list r []))))
(check "reduced is opaque when printed" "#<reduced 3>" (pr-str (reduced 3)))

(check "filter" '(2 3) (filter pos? [-1 0 2 3]))
(check "filter nil" '() (filter pos? nil))
(check "filter truthy result" '(1 2) (filter (constantly 0) [1 2]))
(check "remove" '(-1 0) (remove pos? [-1 0 2 3]))
(check "keep drops nil only" '(false 0 1) (keep identity [nil false 0 1]))
(check "filter vector result" [2 3] (filterv pos? [-1 0 2 3]))
(check "filterv keeps vector type" true (vector? (filterv pos? [])))
(check "mapv" [2 3 4] (mapv inc '(1 2 3)))
(check "mapv stops at shortest collection" [11 22] (mapv + [1 2 3] [10 20]))
(check "mapv three collections" [[1 3 5] [2 4 6]] (mapv vector [1 2] [3 4] [5 6 7]))
(check "mapv many collections" [[1 2 3 4 5]] (mapv vector [1] [2] [3] [4] [5]))
(check "mapv nil" [] (mapv inc nil))
(check "every empty" true (every? pos? nil))
(check "every true" true (every? pos? [1 2]))
(check "every false" false (every? pos? [1 0 2]))
(check "not every" true (not-every? pos? [1 0 2]))
(check "not every empty" false (not-every? pos? []))
(check "some returns predicate value" 3 (some (fn* (x) (if (pos? x) x nil)) [-1 3 4]))
(check "some false results" nil (some (constantly false) [1 2]))
(check "some truthy zero" 0 (some (constantly 0) [1]))
(check "not any" true (not-any? pos? [-1 0]))
(check "not any empty" true (not-any? pos? nil))
(check "take" '(1 2) (take 2 [1 2 3]))
(check "take too many" '(1 2) (take 10 [1 2]))
(check "take negative" '() (take -1 [1 2]))
(check "take fractional count" '(1 2) (take 1.5 [1 2 3]))
(check "drop" '(3) (drop 2 [1 2 3]))
(check "drop too many" '() (drop 10 [1 2]))
(check "drop negative" '(1 2) (drop -1 [1 2]))
(check "drop fractional count" '(3) (drop 1.5 [1 2 3]))
(check "take while" '(1 2) (take-while pos? [1 2 0 3]))
(check "drop while" '(0 3) (drop-while pos? [1 2 0 3]))
(check "take while empty" '() (take-while pos? nil))
(check "drop while empty" '() (drop-while pos? nil))

(def! original {:a {:b [1 2]} :present nil :false false})
(check "get in nested vector" 2 (get-in original [:a :b 1]))
(check "get in missing default" :missing (get-in original [:a :missing] :missing))
(check "get in preserves nil" nil (get-in original [:present] :missing))
(check "get in preserves false" false (get-in original [:false] :missing))
(check "get in through nil" :missing (get-in original [:present :b] :missing))
(check "get in empty path" original (get-in original [] :missing))
(check "get in nil path" original (get-in original nil))
(check "get in invalid vector index" :missing (get-in [1] [2] :missing))
(check "get in fractional vector index" :missing (get-in [1] [0.5] :missing))
(check "get in scalar" :missing (get-in 1 [:a] :missing))
(check "assoc in creates levels" {:a {:b 7}} (assoc-in nil [:a :b] 7))
(check "assoc in changes vector" {:a [1 7]} (assoc-in {:a [1 2]} [:a 1] 7))
(check "assoc in appends vector" [1 2] (assoc-in [1] [1] 2))
(check "assoc in empty path" {nil 7} (assoc-in {} [] 7))
(check "update" {:a 4} (update {:a 1} :a + 3))
(check "update missing" {:a 3} (update nil :a (constantly 3)))
(check "update vector" [2 2] (update [1 2] 0 inc))
(check "update in" {:a [1 5]} (update-in {:a [1 2]} [:a 1] + 3))
(check "update in creates levels" {:a {:b [1 2]}} (update-in nil [:a :b] (fn* (old x y) [x y]) 1 2))
(check "update in empty path" {:a 1 nil 4} (update-in {:a 1} [] (constantly 4)))
(check "original map unchanged" 2 (get-in original [:a :b 1]))
(check "select keys keeps nil and false" {:present nil :false false} (select-keys original [:present :false :missing]))
(check "select keys nil" {} (select-keys nil [:a]))
(check "select keys vector" {1 20} (select-keys [10 20] [1 3]))
(check "merge" {:a 2 :b nil} (merge {:a 1} nil {:a 2 :b nil}))
(check "merge no maps" nil (merge))
(check "merge all nil" nil (merge nil nil))
(check "merge empty map" {} (merge nil {} nil))
(check "assoc in preserves metadata" {:tag 1} (meta (assoc-in (with-meta {:a 1} {:tag 1}) [:a] 2)))
(check "merge preserves metadata" {:tag 1} (meta (merge (with-meta {:a 1} {:tag 1}) {:b 2})))
(check "select keys preserves metadata" {:tag 1} (meta (select-keys (with-meta {:a 1} {:tag 1}) [:a])))

(check "and identity" true (and))
(check "or identity" nil (or))
(check "and returns last value" 7 (and true 0 [] 7))
(check "and preserves false" false (and 1 false missing))
(check "and preserves nil" nil (and 1 nil missing))
(check "or returns first truthy value" 0 (or nil false 0 missing))
(check "or final false" false (or nil false))
(check "when skips body" nil (when false missing))
(check "when returns final form" 3 (when true 1 2 3))
(check "when empty body" nil (when true))
(check "when not" 3 (when-not nil 1 3))
(check "when not skips" nil (when-not 0 missing))
(check "if let truthy" 3 (if-let [x 2] (inc x) missing))
(check "if let false" 3 (if-let [x false] missing 3))
(check "if let default" nil (if-let [x nil] missing))
(check "if some keeps false" false (if-some [x false] x missing))
(check "if some nil" 3 (if-some [x nil] missing 3))
(check "if some default" nil (if-some [x nil] missing))
(check "when let" 3 (when-let [x 2] (inc x)))
(check "when let skips" nil (when-let [x false] missing))
(check "when some keeps false" false (when-some [x false] 1 x))
(check "when some skips" nil (when-some [x nil] missing))
(check "conditional binding outer scope" 9 (let* [x 9] (if-let [x false] missing x)))
(check "conditional closure capture" 9 (let* [x 9] (if-let [x (fn* () x)] (x) missing)))
(check "conditional binding does not leak" 9 (let* [x 9] (do (if-let [x 2] x) x)))
(check "nil predicate shadow" false (let* [nil? (constantly true)] (if-some [x false] x 7)))

(def! calls (atom []))
(def! record (fn* (x) (do (swap! calls (fn* (xs) (conj xs x))) x)))
(check "reduce early exit" 3
       (reduce (fn* (n x) (do (record x) (if (= x 3) (reduced n) (+ n x)))) 0 [1 2 3 4]))
(check "reduce stops callback" [1 2 3] @calls)
(reset! calls [])
(check "every short circuits" false (every? (fn* (x) (do (record x) (pos? x))) [1 0 2]))
(check "every call order" [1 0] @calls)
(reset! calls [])
(check "some short circuits" 2 (some (fn* (x) (do (record x) (if (pos? x) x nil))) [0 2 3]))
(check "some call order" [0 2] @calls)
(reset! calls [])
(check "drop while result" '(0 2 3) (drop-while (fn* (x) (do (record x) (pos? x))) [1 0 2 3]))
(check "drop while stops predicate" [1 0] @calls)
(reset! calls [])
(check "mapv evaluation order" [1 2 3] (mapv record [1 2 3]))
(check "mapv callback order" [1 2 3] @calls)
(reset! calls [])
(check "and evaluates once" 3 (and (record 1) (record 2) (record 3)))
(check "and order" [1 2 3] @calls)
(reset! calls [])
(check "or evaluates once" 2 (or (record nil) (record false) (record 2) (record 3)))
(check "or order" [nil false 2] @calls)
(reset! calls [])
(check "if let evaluates once" 4 (if-let [x (record 2)] (+ x x) 0))
(check "if let count" [2] @calls)

(check "bad numeric input" true (fails? (fn* () (inc nil))))
(check "bad zero predicate input" true (fails? (fn* () (zero? "0"))))
(check "bad helper arity" true (fails? (fn* () (identity))))
(check "bad collection input" true (fails? (fn* () (filter pos? 1))))
(check "bad count input" true (fails? (fn* () (take :bad [1]))))
(check "bad map update" true (fails? (fn* () (assoc-in {:a 1} [:a :b] 2))))
(check "bad vector write" true (fails? (fn* () (assoc-in [1] [3] 2))))
(check "bad fractional vector write" true (fails? (fn* () (assoc-in [1] [0.5] 2))))
(check "bad merge input" true (fails? (fn* () (merge {} 1))))
(check "bad select keys input" true (fails? (fn* () (select-keys 1 [:a]))))
(check "callback errors escape" "callback failed"
       (try* (reduce (fn* (a b) (throw "callback failed")) 0 [1]) (catch* e e)))
(check "map callback errors escape" "callback failed"
       (try* (mapv (fn* (x) (throw "callback failed")) [1]) (catch* e e)))
(check "predicate errors escape" "callback failed"
       (try* (filter (fn* (x) (throw "callback failed")) [1]) (catch* e e)))
(check "bad binding shape" true (fails? (fn* () (if-let [x] 1 2))))
(check "bad binding name" true (fails? (fn* () (when-some [:x 1] 2))))
(check "extra conditional argument" true (fails? (fn* () (if-some [x 1] 2 3 4))))

(println (str "PASS: " @checks " core helper checks"))
