#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
CSOUND = os.environ.get("CSOUND", "csound")
ENV_CONSTRUCTOR = os.environ.get("MAL_ENV_CONSTRUCTOR", "MalMkStep2Env")
READLINE_BRIDGE = os.environ.get("MAL_READLINE_BRIDGE") == "1"
READLINE_FORM = re.compile(
    r'^\s*\(\s*readline\s+("(?:\\.|[^"\\])*")\s*\)\s*$'
)

CSOUND_NOISE = (
    re.compile(r"^--Csound version "),
    re.compile(r"^\[commit: "),
    re.compile(r"^setting path "),
    re.compile(r"^scoreless operation$"),
    re.compile(r"^orchname:"),
    re.compile(r"^Compiling Csound code"),
    re.compile(r"^instr .* uses instrument number"),
    re.compile(r"^\t \.\.\.done$"),
    re.compile(r"^Elapsed time "),
    re.compile(r"^using libsndfile-"),
    re.compile(r"^displays suppressed$"),
    re.compile(r"^sr = "),
    re.compile(r"^0dBFS level = "),
    re.compile(r"^audio buffered in "),
    re.compile(r"^not writing to sound disk$"),
    re.compile(r"^SECTION 1:$"),
    re.compile(r"^inactive allocs returned to freespace$"),
    re.compile(r"^\t\t   overall amps:"),
    re.compile(r"^\t   overall samples out of range:"),
    re.compile(r"^0 errors in performance$"),
    re.compile(r"^no sound written to disk$"),
)


def is_csound_noise(line):
    return line == "" or any(pattern.search(line) for pattern in CSOUND_NOISE)


def build_orc(history):
    eval_lines = []
    strset_values = []

    for source, input_line in history:
        strset_values.append(source)
        source_index = len(strset_values)

        if input_line is not None:
            strset_values.append(input_line)
            input_index = len(strset_values)
            eval_lines.extend(
                [
                    f"  SreadlineInput strget {input_index}",
                    "  iQueued = MalInputEnqueue(SreadlineInput, $MAL_INPUT_LINE)",
                ]
            )

        eval_lines.extend(
            [
                f"  Sinput strget {source_index}",
                "  Sresult, env = REP_ENV(Sinput, env)",
            ]
        )

    source = "\n".join(
        [
            '#include "src/main.orc"',
            "",
            "opcode READ(input:S):MalValue",
            "  xout read_str(input)",
            "endop",
            "",
            "opcode PRINT(ast:MalValue):S",
            "  xout pr_str_with_readability(ast, 1)",
            "endop",
            "",
            "opcode REP_ENV(input:S, env:MalEnv):(S, MalEnv)",
            "  ast:MalValue = READ(input)",
            "  currentEnv:MalEnv = env",
            "",
            "  if (ast.type == $MAL_ERROR_TYPE) then",
            "    result:S = ast.string",
            "  else",
            "    evaluated:MalValue, currentEnv = EVAL_ENV(ast, currentEnv)",
            "",
            "    if (evaluated.type == $MAL_ERROR_TYPE) then",
            "      result = evaluated.string",
            "    else",
            "      result = PRINT(evaluated)",
            "    endif",
            "  endif",
            "",
            "  xout result, currentEnv",
            "endop",
            "",
            "instr RUN",
            f"  env:MalEnv = {ENV_CONSTRUCTOR}()",
            '  Sinput = ""',
            '  Sresult = ""',
            "  iQueued:i = 0",
            *eval_lines,
            '  prints "%s\\n", Sresult',
            "  exitnow(0)",
            "endin",
            "",
            'schedule("RUN", 0, 0)',
            "",
        ]
    )
    return source, strset_values


def eval_history(history):
    source, strset_values = build_orc(history)

    with tempfile.NamedTemporaryFile(
        "w", suffix=".orc", dir=ROOT, delete=False
    ) as file:
        file.write(source)
        step_file = Path(file.name)

    try:
        strset_args = [
            f"--strset{index}={value}"
            for index, value in enumerate(strset_values, start=1)
        ]
        proc = subprocess.run(
            [CSOUND, "-n", "-d", "-m128", *strset_args, "--orc", str(step_file)],
            cwd=ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
    finally:
        try:
            step_file.unlink()
        except OSError:
            pass

    lines = [line for line in proc.stdout.splitlines() if not is_csound_noise(line)]
    if proc.returncode != 0:
        if lines:
            return "\n".join(lines)
        return f"Error: csound exited with {proc.returncode}"
    return "\n".join(lines)


def prompt():
    sys.stdout.write("user> ")
    sys.stdout.flush()


def readline_prompt(source):
    if not READLINE_BRIDGE:
        return None

    match = READLINE_FORM.match(source)
    if match is None:
        return None

    try:
        return json.loads(match.group(1))
    except json.JSONDecodeError:
        return None


def main():
    history = []
    pending_readline = None
    prompt()

    for line in sys.stdin:
        source = line.rstrip("\n")

        if pending_readline is not None:
            history.append((pending_readline, source))
            pending_readline = None
        else:
            requested_prompt = readline_prompt(source)

            if requested_prompt is not None:
                pending_readline = source
                sys.stdout.write(requested_prompt)
                sys.stdout.flush()
                continue

            history.append((source, None))

        output = eval_history(history)

        if output:
            sys.stdout.write(output)
            if not output.endswith("\n"):
                sys.stdout.write("\n")
        prompt()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
